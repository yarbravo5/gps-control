APP_NAME=GPS Control API
ENVIRONMENT=development
API_DOCS_ENABLED=true

# Si se define, tiene prioridad sobre DB_* (Neon, Render u otro Postgres gestionado).
# DATABASE_URL=postgresql+psycopg://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=gps_control_db
DB_USER=gps_control_user
DB_PASSWORD=

JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_IDENTITY_REQUESTS=10
LOGIN_RATE_LIMIT_SOURCE_REQUESTS=300
# Solo CIDR de los proxies que controlas; vacío implica confiar únicamente en la IP del socket.
TRUSTED_PROXY_IPS=

# Con proxy same-origin en Vercel:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# Sin proxy, con frontend en otro dominio:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

WIALON_TOKEN=
WIALON_HOST=hst-api.wialon.com
WIALON_HTTP_TIMEOUT_SECONDS=10
WIALON_RETRY_ATTEMPTS=3
WIALON_RETRY_BASE_DELAY_SECONDS=0.25
WIALON_READ_CACHE_TTL_SECONDS=10
# Una unidad sin posición válida o sin mensajes en este intervalo se marca no_signal.
WIALON_NO_SIGNAL_AFTER_SECONDS=600

CORS_ORIGINS=http://localhost:5173

ADMIN_EMAIL=admin@gpscontrol.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=ChangeMe123!
